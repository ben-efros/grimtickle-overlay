From: Copilot <223556219+Copilot@users.noreply.github.com>
Subject: [PATCH] usb: typec: rts5453: fix partner ERR_PTR leak and reduce log noise

typec_register_partner() can fail (e.g. -ENOMEM). The previous code
left typec->partner holding the resulting ERR_PTR() value in that
case. On the next disconnect event, that bogus non-NULL pointer would
be passed straight to typec_unregister_partner(), operating on an
invalid pointer instead of NULL. Clear typec->partner back to NULL
on registration failure so the next connect event cleanly retries
registration, and only call typec_unregister_partner() when a partner
is actually registered.

Also downgrade the per-interrupt six-byte PD/HPD status dump from
dev_info() to dev_dbg(). This fires on every PD/HPD interrupt and
floods the kernel log during sustained USB operation; this is a
verbosity-only change with no behavioral effect.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
diff --git a/drivers/usb/typec/rts5453.c b/drivers/usb/typec/rts5453.c
index 111111111111..222222222222 100644
--- a/drivers/usb/typec/rts5453.c
+++ b/drivers/usb/typec/rts5453.c
@@ -266,17 +266,31 @@ static int rts5453h_typec_port_update(struct rts5453h *typec)
 	typec->hpd_status = dp_data.status;
 
 	if ((typec->data_status[1] == 0) && (typec->data_status[2] == 0)) {
-		dev_info(typec->dev, "typec port(%d): unregister partner\n", typec->id);
-		typec_unregister_partner(typec->partner);
-		typec->partner = NULL;
+		if (typec->partner) {
+			dev_info(typec->dev, "typec port(%d): unregister partner\n", typec->id);
+			typec_unregister_partner(typec->partner);
+			typec->partner = NULL;
+		}
 	} else {
 		if (NULL == typec->partner) {
 			dev_info(typec->dev, "typec port(%d): register partner\n", typec->id);
 			typec->partner = typec_register_partner(typec->port, &typec->desc);
-		}
 
-		if (IS_ERR(typec->partner)) {
-			dev_info(typec->dev, "typec port(%d): register partner error \n", typec->id);
+			/*
+			 * typec_register_partner() can fail (e.g. -ENOMEM).
+			 * The previous code left typec->partner holding the
+			 * ERR_PTR() value in that case, which would then be
+			 * passed to typec_unregister_partner() on the next
+			 * disconnect - operating on a bogus non-NULL pointer.
+			 * Clear it back to NULL so the register attempt is
+			 * cleanly retried on the next connect event instead.
+			 */
+			if (IS_ERR(typec->partner)) {
+				dev_err(typec->dev,
+					"typec port(%d): register partner failed: %ld\n",
+					typec->id, PTR_ERR(typec->partner));
+				typec->partner = NULL;
+			}
 		}
 	}
 	typec->port->orientation = orientation;
@@ -318,7 +332,12 @@ static int rts5453h_event_handler(struct rts5453h *rts, u8 clear_irq)
 	if (ret != 0 ) {
 		goto i2c_err;
 	} else {
-		dev_info(rts->dev, "typec port(%d):data status = 0x%x , 0x%x, 0x%x, 0x%x, 0x%x, 0x%x\n",
+		/*
+		 * This fires on every PD/HPD interrupt; keep it at dev_dbg
+		 * to avoid flooding the log during sustained USB operation.
+		 * It changes no behavior, only log verbosity.
+		 */
+		dev_dbg(rts->dev, "typec port(%d):data status = 0x%x , 0x%x, 0x%x, 0x%x, 0x%x, 0x%x\n",
 			rts->id, rts->data_status[0], rts->data_status[1], rts->data_status[2], rts->data_status[3], rts->data_status[4], rts->data_status[5]);
 	}
 
