diff --git a/drivers/phy/cix/phy-cix-usb2.c b/drivers/phy/cix/phy-cix-usb2.c
index 111111111111..222222222222 100644
--- a/drivers/phy/cix/phy-cix-usb2.c
+++ b/drivers/phy/cix/phy-cix-usb2.c
@@ -8,6 +8,7 @@
 #include <linux/reset.h>
 #include <linux/kernel.h>
 #include <linux/of_platform.h>
+#include <linux/soc/cix/cix-acpi-resource-lookup.h>
 
 static const struct acpi_device_id cix_usb2phy_acpi_match[] = {
 	{ "CIXH2032" },
@@ -29,14 +30,20 @@ static int cix_usb2phy_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
 	struct reset_control *preset;
+	int ret;
 
 	preset = devm_reset_control_get(dev, "preset");
+	if (IS_ERR(preset))
+		return dev_err_probe(dev,
+				      cix_acpi_resource_lookup_defer(dev, PTR_ERR(preset)),
+				      "failed to get preset\n");
 
-	if (IS_ERR(preset)) {
-		dev_err(dev, "%s: failed to get preset\n", __func__);
-	} else {
-		reset_control_deassert(preset);
-	}
+	ret = reset_control_deassert(preset);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				      "failed to deassert preset\n");
+
+	dev_info(dev, "CIX USB2 PHY preset ready\n");
 
 	return 0;
 }
