+/*
+ * MS-R1 wires two RTS5453 PD controllers (PD00 at 0x30, PD01 at 0x31) to
+ * the same physical GPIO/IRQ line on their shared I2C adapter, each
+ * described in ACPI as its own (incorrectly) "Exclusive" GpioInt. Rather
+ * than electing one of the two i2c_clients as a permanent IRQ "owner" and
+ * having it poll its sibling on every interrupt (the previous approach),
+ * the interrupt line is now owned by this separate per-adapter/per-IRQ
+ * group object. The group creates a single SMBus Alert Response Address
+ * (ARA) client on the adapter, and lets the generic SMBus ARA core
+ * (drivers/i2c/i2c-smbus.c) own the single physical IRQ request and run
+ * its own synchronous, bounded ARA-drain threaded handler; the ARA read
+ * tells us which specific chip is alerting, so only that chip's
+ * .alert() runs - never both, and never an elected "representative".
+ *
+ * The group is keyed by (i2c_adapter pointer, Linux IRQ number) rather
+ * than any hard-coded bus/IRQ number, since Linux's dynamic IRQ/bus
+ * numbering can change across boots or platforms.
+ *
+ * IRQ enable/disable and wake-enable/disable for the shared physical
+ * line are also owned here (pm_lock/irq_disable_depth/wake_depth)
+ * rather than being called once per member device directly against
+ * client->irq: two members independently calling disable_irq()/
+ * enable_irq() (or the wake equivalents) does compose correctly via the
+ * interrupt core's own per-irq_desc depth counting in the common case,
+ * but is fragile across partial-probe, single-member remove/shutdown,
+ * and PM-callback-failure interleavings, where one member's IRQ calls
+ * can end up unbalanced against the other's. Making the group the sole
+ * caller of disable_irq()/enable_irq()/enable_irq_wake()/
+ * disable_irq_wake() - counted once per requesting member here - removes
+ * that fragility. The disable_pd_interrupt sysfs test knob also goes
+ * through these wrappers for the same reason: it manipulates the same
+ * shared physical IRQ and must not desynchronize from the depth this
+ * group tracks.
+ */
+struct rts5453_irq_group {
+	struct list_head global_node;
+	struct list_head members;
+	struct mutex members_lock; /* protects members and ara_client */
+	refcount_t refs;
+
+	struct i2c_adapter *adapter;
+	struct i2c_client *ara_client;
+	/*
+	 * i2c_new_smbus_alert_device() stores this pointer as platform
+	 * data; it does not copy the structure. Keep it here for the
+	 * complete lifetime of the ARA client (until
+	 * i2c_unregister_device(group->ara_client) returns), rather than
+	 * on the stack of rts5453_group_start(). This also supports a
+	 * modular i2c_smbus driver, which may probe the client well after
+	 * rts5453_group_start() has returned.
+	 */
+	struct i2c_smbus_alert_setup ara_setup;
+	unsigned int trigger_type;
+
+	int irq;
+
+	struct mutex pm_lock; /* protects irq_disable_depth/wake_depth below */
+	unsigned int irq_disable_depth;
+	unsigned int wake_depth;
+
+	struct dentry *debugfs_dir;
+};
+
+static LIST_HEAD(rts5453_irq_groups);
+static DEFINE_MUTEX(rts5453_irq_groups_lock);
+
+static struct dentry *rts5453_debugfs_root;
+
+/*
+ * Bounded retry policy for applying a captured status update (Type-C
+ * switch/mux/role-switch/CDNSP-reset side effects) when one of those
+ * calls fails. This is a software backoff policy, not a hardware
+ * timing requirement, so a small fixed count/delay is used rather than
+ * anything derived from register timing documentation.
+ */
+#define RTS5453_APPLY_MAX_RETRIES	5
+#define RTS5453_APPLY_RETRY_DELAY	msecs_to_jiffies(50)
+
+/*
+ * A capture (I2C ack/read/HPD-ack sequence) failure is only treated as
+ * indicating the device is permanently gone (I2C_INT_ACK_BIT write,
+ * status read etc. return -ENODEV/-ENXIO/-ESHUTDOWN) after this many
+ * consecutive failures of any kind, even if none of them individually
+ * look permanent - sustained repeated I/O errors on a shared bus are
+ * themselves a strong signal something is wrong.
+ */
+#define RTS5453_OFFLINE_ERROR_THRESHOLD	16
+
