+
+	struct dentry *debugfs_file;
+};
 
 #define RTS_MAX_LEN	64
 
@@ -137,6 +251,47 @@ char oritation_reverse[] = "oritation reverse";
 char data_host[] = "usb host";
 char data_device[] = "usb device";
 
+/*
+ * Rich, single-line context for every ARA/I2C/switch/mux/role/reset
+ * failure: device/port id, adapter+address, Linux IRQ, the failing
+ * operation and its original errno, all six raw status bytes (as of
+ * the last successful read), cached mode/orientation/role, pending/
+ * applied generation, and the current consecutive-failure count.
+ * Always logs (never dropped) - callers are responsible for only
+ * invoking this at the point a failure/transition first occurs, or
+ * apply a widening interval themselves for genuinely repeated
+ * failures, rather than this helper trying to guess a rate limit.
+ */
+static void rts5453_log_context(struct rts5453h *rts, const char *op, int err)
+{
+	struct i2c_client *client = rts->client;
+	int consecutive = max(atomic_read(&rts->consecutive_apply_errors),
+			       atomic_read(&rts->consecutive_capture_errors));
+	bool ara_active = rts->irq_group && rts->irq_group->ara_client;
+
+	dev_err(rts->dev,
+		"port(%d) i2c-%d@0x%02x irq=%d: %s failed err=%d status=[%02x %02x %02x %02x %02x %02x] mode=%lu hpd=0x%x orientation=%d role=%d pending_gen=%lu applied_gen=%lu consecutive_errors=%d ara_active=%d\n",
+		rts->id, client->adapter->nr, client->addr, client->irq,
+		op, err,
+		rts->data_status[0], rts->data_status[1], rts->data_status[2],
+		rts->data_status[3], rts->data_status[4], rts->data_status[5],
+		rts->mode, rts->hpd_status, rts->orientation, rts->role,
+		rts->pending_generation, rts->applied_generation,
+		consecutive, ara_active);
+}
+
+/*
+ * Logs at every occurrence for the first few consecutive failures of a
+ * given kind (so the initial failure and its immediate repeats are
+ * never silently dropped), then falls back to only logging on every
+ * 16th occurrence to avoid flooding dmesg under sustained bus errors.
+ */
+static void rts5453_log_context_throttled(struct rts5453h *rts, const char *op, int err,
+					   int consecutive)
+{
+	if (consecutive <= 3 || (consecutive % 16) == 0)
+		rts5453_log_context(rts, op, err);
+}
 
