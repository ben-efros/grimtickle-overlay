 {
@@ -153,10 +308,22 @@ static int rts5453h_typec_port_update(struct rts5453h *typec)
 		orientation = TYPEC_ORIENTATION_NORMAL;
 	}
 
-	ret = typec_switch_set(typec->ori_sw, orientation);
-
-	if (ret)
-		return ret;
+	/*
+	 * Only push an orientation change to the switch when it actually
+	 * changed - this call may perform PHY register programming and
+	 * must not be repeated on every status poll/apply cycle just
+	 * because a role or HPD bit changed.
+	 */
+	if (typec->orientation != orientation) {
+		atomic64_inc(&typec->orientation_attempts);
+		ret = typec_switch_set(typec->ori_sw, orientation);
+		if (ret) {
+			rts5453_log_context(typec, "typec_switch_set", ret);
+			return ret;
+		}
+		typec->orientation = orientation;
+		atomic64_inc(&typec->orientation_changes);
+	}
 
 	if ((!(typec->data_status[1] & USB3_2_CONNECTION)) && (!(typec->data_status[1] & USB2_CONNECTION))) {
 		role = USB_ROLE_NONE;
@@ -208,10 +375,23 @@ static int rts5453h_typec_port_update(struct rts5453h *typec)
 		typec->state.data = NULL;
 	}
 
-	ret = typec_mux_set(typec->mux, &typec->state);
-
-	if (ret)
-		return ret;
+	/*
+	 * Skip the mux_set() call only when neither the mux mode nor the
+	 * DP status/HPD bits changed since the last successful apply -
+	 * dp_data.status carries the HPD IRQ/state bits even when
+	 * state.mode is unchanged (e.g. an HPD IRQ pulse on an already
+	 * connected DP altmode), so both must be compared or HPD
+	 * hot-plug notifications would silently stop being delivered.
+	 */
+	if (typec->mode != typec->state.mode || typec->hpd_status != dp_data.status) {
+		atomic64_inc(&typec->mux_attempts);
+		ret = typec_mux_set(typec->mux, &typec->state);
+		if (ret) {
+			rts5453_log_context(typec, "typec_mux_set", ret);
+			return ret;
+		}
+		atomic64_inc(&typec->mux_changes);
+	}
 
 	if ((typec->data_status[3]& POWER_MASK) == POWER_SOURCE) {
 		typec->caps.type = TYPEC_PORT_SRC;
@@ -224,8 +404,24 @@ static int rts5453h_typec_port_update(struct rts5453h *typec)
 	}
 
 	if (typec->role != role) {
-		typec->role = role;
+		/*
+		 * Only cache the new role after usb_role_switch_set_role()
+		 * actually succeeds. The previous code assigned typec->role
+		 * = role first: on failure the cache would already reflect
+		 * the requested role even though the switch/CDNSP reset
+		 * never happened, so an identical subsequent status read
+		 * (role unchanged from the chip's point of view) would
+		 * never retry the switch, permanently losing the role
+		 * change.
+		 */
+		atomic64_inc(&typec->role_attempts);
 		ret = usb_role_switch_set_role(typec->role_sw, role);
+		if (ret) {
+			rts5453_log_context(typec, "usb_role_switch_set_role", ret);
+			return ret;
+		}
+		typec->role = role;
+		atomic64_inc(&typec->role_changes);
 		if (role == USB_ROLE_DEVICE) {
 			typec_set_data_role(typec->port, TYPEC_DEVICE);
 		} else {
@@ -311,58 +507,196 @@ static void rts5453h_typec_register_port_altmodes(struct rts5453h *typec)
 	typec->desc.usb_pd = 0;
 }
 
-static int rts5453h_event_handler(struct rts5453h *rts, u8 clear_irq)
