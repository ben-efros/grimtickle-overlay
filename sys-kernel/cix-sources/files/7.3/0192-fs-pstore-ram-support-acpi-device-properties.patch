From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: grimtickle-overlay <overlay@localhost>
Subject: [PATCH] fs: pstore: ramoops: support ACPI device properties

The MS-R1 firmware describes the ramoops region as an ACPI device
(Device RAOP, _HID "PRP0001", _DSD compatible="ramoops" plus
record-size/console-size/pmsg-size), so it enumerates as a platform
device with a fwnode but no of_node. ramoops_parse_dt() used the
OF-only accessors (of_property_read_u32(pdev->dev.of_node, ...)),
so on this board probe failed:

  ramoops: NULL platform data
  ramoops PRP0001:03: probe with driver ramoops failed with error -22

with the result that no persistent crash log exists.

Switch to the generic device-property API so the same code works for
both devicetree and ACPI/PRP0001, keep the reserved-memory parent
handling explicitly OF-only, zero-initialise the local platform data,
and key the property path off dev_fwnode() rather than dev_of_node().

Ported from ncz-os/meta-cix 7.3-rc7 (sky1-ncz-v7.3-rc7-port.patch,
fs/pstore/ram.c).
diff --git a/fs/pstore/ram.c b/fs/pstore/ram.c
index 2eb0d4fa2186..714a0985f2c9 100644
--- a/fs/pstore/ram.c
+++ b/fs/pstore/ram.c
@@ -20,6 +20,7 @@
 #include <linux/compiler.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
+#include <linux/property.h>
 #include <linux/mm.h>
 
 #include "internal.h"
@@ -615,27 +616,25 @@ static int ramoops_init_prz(const char *name,
 	return 0;
 }
 
-/* Read a u32 from a dt property and make sure it's safe for an int. */
-static int ramoops_parse_dt_u32(struct platform_device *pdev,
-				const char *propname,
-				u32 default_value, u32 *value)
+/* Read a u32 from a device property and make sure it's safe for an int. */
+static int ramoops_parse_u32(struct device *dev, const char *propname,
+			     u32 default_value, u32 *value)
 {
-	u32 val32 = 0;
+	u32 val32;
 	int ret;
 
-	ret = of_property_read_u32(pdev->dev.of_node, propname, &val32);
+	ret = device_property_read_u32(dev, propname, &val32);
 	if (ret == -EINVAL) {
 		/* field is missing, use default value. */
 		val32 = default_value;
 	} else if (ret < 0) {
-		dev_err(&pdev->dev, "failed to parse property %s: %d\n",
-			propname, ret);
+		dev_err(dev, "failed to parse property %s: %d\n", propname, ret);
 		return ret;
 	}
 
 	/* Sanity check our results. */
 	if (val32 > INT_MAX) {
-		dev_err(&pdev->dev, "%s %u > INT_MAX\n", propname, val32);
+		dev_err(dev, "%s %u > INT_MAX\n", propname, val32);
 		return -EOVERFLOW;
 	}
 
@@ -643,21 +642,19 @@ static int ramoops_parse_dt_u32(struct platform_device *pdev,
 	return 0;
 }
 
-static int ramoops_parse_dt(struct platform_device *pdev,
-			    struct ramoops_platform_data *pdata)
+static int ramoops_parse_properties(struct platform_device *pdev,
+				    struct ramoops_platform_data *pdata)
 {
-	struct device_node *of_node = pdev->dev.of_node;
-	struct device_node *parent_node;
+	struct device *dev = &pdev->dev;
 	struct resource *res;
 	u32 value;
 	int ret;
 
-	dev_dbg(&pdev->dev, "using Device Tree\n");
+	dev_dbg(dev, "using device properties\n");
 
 	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
 	if (!res) {
-		dev_err(&pdev->dev,
-			"failed to locate DT /reserved-memory resource\n");
+		dev_err(dev, "failed to locate memory resource\n");
 		return -EINVAL;
 	}
 
@@ -667,19 +664,19 @@ static int ramoops_parse_dt(struct platform_device *pdev,
 	 * Setting "unbuffered" is deprecated and will be ignored if
 	 * "mem_type" is also specified.
 	 */
-	pdata->mem_type = of_property_read_bool(of_node, "unbuffered");
+	pdata->mem_type = device_property_read_bool(dev, "unbuffered");
 	/*
 	 * Setting "no-dump-oops" is deprecated and will be ignored if
 	 * "max_reason" is also specified.
 	 */
-	if (of_property_read_bool(of_node, "no-dump-oops"))
+	if (device_property_read_bool(dev, "no-dump-oops"))
 		pdata->max_reason = KMSG_DUMP_PANIC;
 	else
 		pdata->max_reason = KMSG_DUMP_OOPS;
 
 #define parse_u32(name, field, default_value) {				\
-		ret = ramoops_parse_dt_u32(pdev, name, default_value,	\
-					    &value);			\
+		ret = ramoops_parse_u32(dev, name, default_value,	\
+					&value);			\
 		if (ret < 0)						\
 			return ret;					\
 		field = value;						\
@@ -707,14 +704,18 @@ static int ramoops_parse_dt(struct platform_device *pdev,
 	 * we're not a child of "reserved-memory" and mimicking the
 	 * expected behavior.
 	 */
-	parent_node = of_get_parent(of_node);
-	if (!of_node_name_eq(parent_node, "reserved-memory") &&
-	    !pdata->console_size && !pdata->ftrace_size &&
-	    !pdata->pmsg_size && !pdata->ecc_info.ecc_size) {
-		pdata->console_size = pdata->record_size;
-		pdata->pmsg_size = pdata->record_size;
+	if (dev_of_node(dev)) {
+		struct device_node *parent_node;
+
+		parent_node = of_get_parent(dev->of_node);
+		if (!of_node_name_eq(parent_node, "reserved-memory") &&
+		    !pdata->console_size && !pdata->ftrace_size &&
+		    !pdata->pmsg_size && !pdata->ecc_info.ecc_size) {
+			pdata->console_size = pdata->record_size;
+			pdata->pmsg_size = pdata->record_size;
+		}
+		of_node_put(parent_node);
 	}
-	of_node_put(parent_node);
 
 	return 0;
 }
@@ -723,7 +724,7 @@ static int ramoops_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
 	struct ramoops_platform_data *pdata = dev->platform_data;
-	struct ramoops_platform_data pdata_local;
+	struct ramoops_platform_data pdata_local = { };
 	struct ramoops_context *cxt = &oops_cxt;
 	size_t dump_mem_sz;
 	phys_addr_t paddr;
@@ -738,11 +739,10 @@ static int ramoops_probe(struct platform_device *pdev)
 		goto fail_out;
 	}
 
-	if (dev_of_node(dev) && !pdata) {
+	if (dev_fwnode(dev) && !pdata) {
 		pdata = &pdata_local;
-		memset(pdata, 0, sizeof(*pdata));
 
-		err = ramoops_parse_dt(pdev, pdata);
+		err = ramoops_parse_properties(pdev, pdata);
 		if (err < 0)
 			goto fail_out;
 	}
