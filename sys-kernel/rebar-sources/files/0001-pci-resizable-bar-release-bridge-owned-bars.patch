PCI: Reassign bridge resources when bridge BARs pin windows

On Lenovo P920 systems with Intel C621, firmware may leave PCIe
apertures insufficient for large BARs. With pci=realloc=on, Linux
attempts to release and reassign the affected bridge windows.

The existing resource reallocation path releases endpoint BARs and
downstream bridge windows, but a BAR belonging to a downstream PCI
bridge may remain allocated from the bridge window. This leaves the
window with an assigned child resource and prevents it from being
released.

Release movable bridge BARs that are direct children of the window
before attempting to release the window. Keep the released BARs on
the saved resource list so the existing resource allocation path can
restore or reassign them.

Fixed bridge BARs are not moved.

This permits the affected bridge window to be completely released and
reallocated, allowing large endpoint BARs such as those used by Intel
Arc GPUs to be assigned.

---
 drivers/pci/setup-bus.c | 91 +++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 86 insertions(+), 5 deletions(-)

diff --git a/drivers/pci/setup-bus.c b/drivers/pci/setup-bus.c
index 8f2830c6d34f..00a879b9b630 100644
--- a/drivers/pci/setup-bus.c
+++ b/drivers/pci/setup-bus.c
@@ -2300,12 +2300,74 @@
 }
 EXPORT_SYMBOL_GPL(pci_assign_unassigned_bridge_resources);
 
+/*
+ * A downstream PCI bridge may have a movable BAR allocated from
+ * @window. Such a BAR can pin the window even after downstream
+ * bridge windows and endpoint BARs have been released.
+ *
+ * @bus contains the devices below bus->self, which owns @window.
+ * Bridge BARs are ordinary PCI resources and may be direct children
+ * of an upstream bridge window.
+ */
+static int pci_release_bridge_bars_in_window(struct pci_bus *bus,
+						 struct resource *window,
+						 struct list_head *saved)
+{
+	struct pci_dev *dev;
+	struct resource *res;
+	int i, ret;
+
+	list_for_each_entry(dev, &bus->devices, bus_list) {
+		if ((dev->class >> 8) != PCI_CLASS_BRIDGE_PCI)
+			continue;
+
+		pci_dev_for_each_resource(dev, res, i) {
+			if (i >= PCI_BRIDGE_RESOURCES)
+				break;
+
+			if (!resource_assigned(res))
+				continue;
+
+			if (res->parent != window)
+				continue;
+
+			if (res->flags & IORESOURCE_PCI_FIXED) {
+				pci_warn(dev,
+					 "%s %pR is fixed and cannot be moved\n",
+					 pci_resource_name(dev, i), res);
+				return -EBUSY;
+			}
+
+			if (res_to_dev_res(saved, res))
+				continue;
+
+			pci_info(dev,
+				 "%s %pR: temporarily releasing bridge BAR\n",
+				 pci_resource_name(dev, i), res);
+
+			ret = pci_dev_res_add_to_list(saved, dev,
+							  res, 0, 0);
+			if (ret)
+				return ret;
+
+			ret = pci_release_resource(dev, i);
+			if (ret) {
+				pci_dev_res_remove_from_list(saved, res);
+				return ret;
+			}
+		}
+	}
+
+	return 0;
+}
+
 /*
  * Walk to the root bus, find the bridge window relevant for @res and
  * release it when possible. If the bridge window contains assigned
  * resources, it cannot be released.
  */
-static int pbus_reassign_bridge_resources(struct pci_bus *bus, struct resource *res,
+static int pbus_reassign_bridge_resources(struct pci_bus *bus,
+					  struct resource *res,
 					  struct list_head *saved)
 {
 	unsigned long type = res->flags;
@@ -2317,6 +2378,8 @@
 	int ret = 0;
 
 	while (!pci_is_root_bus(bus)) {
+		struct resource *child;
+
 		bridge = bus->self;
 		res = pbus_select_window(bus, res);
 		if (!res)
@@ -2324,18 +2387,51 @@
 
 		i = pci_resource_num(bridge, res);
 
+        /*
+         * A downstream PCI bridge may have a movable BAR allocated from
+         * this bridge's window. Such a BAR can pin the window even after
+         * downstream bridge windows and endpoint BARs have been released.
+         */
+        if (res->child) {
+            ret = pci_release_bridge_bars_in_window(bus, res, saved);
+            if (ret)
+                return ret;
+        }
+
+        if (res->child) {
+            const char *res_name = pci_resource_name(bridge, i);
+
+            pci_warn(bridge,
+                 "%s %pR still contains assigned resources:\n",
+                 res_name, res);
+
+            for (child = res->child; child;
+                 child = child->sibling) {
+                pci_warn(bridge,
+                     "  child %pR name=%s flags=%lx\n",
+                     child,
+                     child->name ?: "<none>",
+                     child->flags);
+            }
+		}
+
 		/* Ignore BARs which are still in use */
 		if (!res->child) {
-			ret = pci_dev_res_add_to_list(saved, bridge, res, 0, 0);
+			ret = pci_dev_res_add_to_list(saved, bridge,
+							  res, 0, 0);
 			if (ret)
 				return ret;
 
-			pci_release_resource(bridge, i);
+			ret = pci_release_resource(bridge, i);
+			if (ret)
+				return ret;
 		} else {
-			const char *res_name = pci_resource_name(bridge, i);
+			const char *res_name =
+				pci_resource_name(bridge, i);
 
 			pci_warn(bridge,
-				 "%s %pR: was not released (still contains assigned resources)\n",
+				 "%s %pR: was not released "
+				 "(still contains assigned resources)\n",
 				 res_name, res);
 		}
 
