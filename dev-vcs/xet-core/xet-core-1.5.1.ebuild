inherit cargo

DESCRIPTION="Hugging Face Xet storage client with chunk-based deduplication and Git LFS compatibility"
HOMEPAGE="https://github.com/huggingface/xet-core"
SRC_URI="
	https://github.com/huggingface/xet-core/archive/refs/tags/v${PV}.tar.gz
		-> ${P}.tar.gz
	$(cargo_crate_uris)
"
S="${WORKDIR}/xet-core-${PV}"

# Main project + bundled crate licenses
LICENSE="Apache-2.0 ISC MIT Unicode-DFS-2016 Unlicense openssl"
SLOT="0"
KEYWORDS="~amd64 ~arm64"

# libgit2-sys links system libgit2 and openssl via pkg-config
DEPEND="
	dev-libs/libgit2:=
	dev-libs/openssl:=
"
RDEPEND="${DEPEND}"
# aws-lc-sys (rustls crypto backend) needs cmake; libgit2-sys needs pkgconfig
BDEPEND="
	>=dev-lang/rust-1.85.0
	dev-build/cmake
	virtual/pkgconfig
"

# Force system libgit2 via pkg-config rather than building bundled copy
src_compile() {
	export LIBGIT2_SYS_USE_PKG_CONFIG=1
	cargo_src_compile --package git_xet
}

src_install() {
	dobin target/release/git-xet
	einstalldocs
}
